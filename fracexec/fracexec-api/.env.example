# FracExec API — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# Spring Profile (local | prod)
SPRING_PROFILE=local

# Database
DB_URL=jdbc:postgresql://localhost:5432/fracexec
DB_USER=fracexec
DB_PASSWORD=change_me_in_production

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_256_bit_random_secret_at_least_32_chars

# Stripe Connect (Brazilian marketplace account)
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid (production only)
SENDGRID_API_KEY=SG....

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:4200
